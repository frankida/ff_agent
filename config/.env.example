# ESPN (primary/money league)
# Get these from Chrome DevTools > Application > Cookies > espn.com
ESPN_SWID={your-swid-here-with-curly-braces}
ESPN_S2=your_espn_s2_cookie_value_here
ESPN_LEAGUE_ID=123456
ESPN_TEAM_ID=1

# Yahoo (secondary league)
# Create app at https://developer.yahoo.com/apps/create/
YAHOO_CLIENT_ID=your_yahoo_client_id
YAHOO_CLIENT_SECRET=your_yahoo_client_secret
YAHOO_LEAGUE_ID=nfl.l.1234567
YAHOO_TEAM_KEY=nfl.l.1234567.t.1

# Claude API
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here

# FantasyPros (optional - leave empty to use scraping)
FANTASYPROS_API_KEY=
